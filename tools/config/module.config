# The minimum the STRELA module needs, on any kernel that will load it. Merged
# into both the board's kernel (tools/build_board_kernel.sh) and the test
# kernels (tools/build_test_kernel.sh).
#
# Keep this list minimal: every line here is something the board has to carry in
# production.

CONFIG_DRM=y
CONFIG_DRM_ACCEL=y
CONFIG_SYNC_FILE=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# DRM_SCHED — the GPU scheduler that runs our job queue — has no prompt: only a
# driver's "select" can enable it, and driver/Kconfig's select is invisible to
# an out-of-tree build. Etnaviv is the cheapest driver to satisfy, depending
# only on DRM and MMU, so it is enabled purely to pull the scheduler in.
CONFIG_DRM_ETNAVIV=y
