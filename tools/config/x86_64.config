# x86-specific. Only ever used by a test kernel: there is no x86 board.
#
# DRM_GEM_DMA_HELPER has no prompt and is only turned on by a driver's
# "select". On ARM the board's own DRM drivers do it; x86 has none, so LogiCVC
# — a Xilinx display block that builds on any architecture under COMPILE_TEST —
# is enabled purely to pull the helper in. Built in rather than a module, so
# its symbols are there without shipping its .ko in the initramfs.

CONFIG_COMPILE_TEST=y
CONFIG_DRM_LOGICVC=y
