# What the test kernels carry on top of module.config: enough to boot the
# harness, and every debug facility worth paying for. Never merged into the
# board's kernel.
#
# Both architectures get this, so a bug that only shows up under lockdep or
# DMA-API debugging is caught on whichever target you happen to run.

# tools/run_qemu.sh boots an initramfs, and the tests need /dev populated.
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# The in-kernel tests at the end of driver/strela_job.c.
CONFIG_KUNIT=y

CONFIG_DEBUG_FS=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DMA_API_DEBUG=y
CONFIG_DEBUG_KMEMLEAK=y
CONFIG_UBSAN=y
CONFIG_UBSAN_ENUM=y

# Slower and much larger, but a use-after-free in the driver fails the run
# instead of passing silently.
CONFIG_KASAN=y
